# Copy to .env and paste your key. `.env` is gitignored; this file is not.
#   cp .env.example .env
#
# Get a key: https://openrouter.ai/settings/keys
# Then enable free-model training at https://openrouter.ai/settings/privacy (README §1)
#
# spawn reads this file from the directory you run it in — repo root, nowhere else.
OPENROUTER_API_KEY=
